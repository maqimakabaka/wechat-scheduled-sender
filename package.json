{
  "name": "wechat-scheduled-sender",
  "version": "2.0.1",
  "private": true,
  "description": "微信定时群发控制台 - Electron 桌面应用（用户文件全部在安装目录下）",
  "author": "Alanine",
  "license": "UNLICENSED",
  "main": "electron/main.js",
  "scripts": {
    "start": "node launch.js",
    "dev": "node launch.js --enable-logging",
    "dist": "node build.js --win --x64",
    "dist:portable": "node build.js --win portable --x64"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.alanine.wechat.sender",
    "productName": "WeChatSender",
    "artifactName": "${productName}-${version}-${arch}.${ext}",
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "frontend/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "backend",
        "to": "backend",
        "filter": [
          "**/*",
          "!__pycache__/**"
        ]
      },
      {
        "from": "frontend",
        "to": "frontend"
      },
      {
        "from": "vendor/python",
        "to": "python"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "微信定时群发控制台"
    }
  }
}